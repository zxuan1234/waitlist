{
  "name": "Teahappy waitlist emails",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "nodes": [
    {
      "parameters": {
        "content": "## Signup (Supabase \u2192 n8n)\nReplace `__CONFIRM_LINK_BASE__` in **Send confirm email** with your n8n **Production** URL for the Confirm webhook, with no query string.\nExample: `https://YOUR.app.n8n.cloud/webhook/teahappy-confirm`\n\nSupabase Database Webhook (Insert only) should POST to this workflow's **Signup webhook** production URL.",
        "height": 240,
        "width": 360,
        "color": 5
      },
      "id": "f1f1f1f1-f1f1-41f1-a1f1-f1f1f1f1f1f1",
      "name": "Note: signup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -280,
        -80
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "teahappy-signup",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "11111111-1111-4111-a111-111111111111",
      "name": "Signup webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "teahappy-signup"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst record = raw.record || (raw.body && raw.body.record) || raw;\nconst email = String(record.email || '').trim().toLowerCase();\nconst token = record.confirm_token;\nconst EMAIL_RE = /^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$/;\nif (!EMAIL_RE.test(email) || !token) {\n  return [];\n}\nreturn [{ json: { email, token: String(token) } }];\n"
      },
      "id": "22222222-2222-4222-a222-222222222222",
      "name": "Check email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "Teahappy <__FROM_EMAIL__>",
        "toEmail": "={{ $json.email }}",
        "subject": "Confirm your Teahappy waitlist spot",
        "html": "=<p>Thanks for joining the Teahappy waitlist.</p><p>Click once to confirm this email. We will only send the free milk tea voucher at launch if you confirm.</p><p><a href=\"__CONFIRM_LINK_BASE__?token={{ $json.token }}\">Confirm my email</a></p><p>If you did not join, ignore this message.</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "33333333-3333-4333-a333-333333333333",
      "name": "Send confirm email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        500,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "SMTP",
          "name": "SMTP (Resend)"
        }
      }
    },
    {
      "parameters": {
        "content": "## Confirm link\nVisitor clicks the mail link (GET).\nn8n patches `confirmed_at` with the **secret** key (bypasses RLS).\nReplace `__SUPABASE_URL__` and `__SUPABASE_SECRET_KEY__` in **Mark confirmed**.\nUse Legacy `service_role` JWT here, never in the website.",
        "height": 240,
        "width": 360,
        "color": 6
      },
      "id": "f2f2f2f2-f2f2-42f2-a2f2-f2f2f2f2f2f2",
      "name": "Note: confirm",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -280,
        280
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "teahappy-confirm",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "44444444-4444-4444-a444-444444444444",
      "name": "Confirm webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        360
      ],
      "webhookId": "teahappy-confirm"
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst body = j.body && typeof j.body === 'object' ? j.body : {};\nconst token = (j.query && j.query.token) || j.token || body.token || '';\nconst ok = /^[0-9a-f-]{36}$/i.test(String(token));\nreturn [{ json: { ok, token: String(token) } }];\n"
      },
      "id": "55555555-5555-4555-a555-555555555555",
      "name": "Read confirm token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "66666666-6666-4666-a666-666666666666",
      "name": "Token looks valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        360
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=__SUPABASE_URL__/rest/v1/waitlist?confirm_token=eq.{{ $json.token }}&confirmed_at=is.null",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "__SUPABASE_SECRET_KEY__"
            },
            {
              "name": "Authorization",
              "value": "Bearer __SUPABASE_SECRET_KEY__"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"confirmed_at\": \"{{ $now.toISO() }}\" }",
        "options": {}
      },
      "id": "77777777-7777-4777-a777-777777777777",
      "name": "Mark confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><meta charset=\"utf-8\"><title>Teahappy</title><p>Email confirmed. We will send your milk tea voucher when the app launches.</p>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "88888888-8888-4888-a888-888888888888",
      "name": "Reply confirmed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><meta charset=\"utf-8\"><title>Teahappy</title><p>That confirm link is invalid or already used.</p>",
        "options": {
          "responseCode": 400,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "99999999-9999-4999-a999-999999999999",
      "name": "Reply invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "content": "## Daily digest to you\nReplace `__STAFF_EMAIL__`, `__FROM_EMAIL__`, `__SUPABASE_URL__`, `__SUPABASE_SECRET_KEY__`.\nRuns every day at 09:00 UTC \u2014 change the Schedule node timezone/hour if you want local morning.\nCSV is new signups in the last 24 hours (not the confirm token).",
        "height": 260,
        "width": 360,
        "color": 4
      },
      "id": "f3f3f3f3-f3f3-43f3-a3f3-f3f3f3f3f3f3",
      "name": "Note: digest",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -280,
        640
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa",
      "name": "Every day 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        760
      ]
    },
    {
      "parameters": {
        "url": "=__SUPABASE_URL__/rest/v1/waitlist?select=email,created_at,confirmed_at&created_at=gte.{{ $now.minus({days:1}).toUTC().toISO() }}&order=created_at.desc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "__SUPABASE_SECRET_KEY__"
            },
            {
              "name": "Authorization",
              "value": "Bearer __SUPABASE_SECRET_KEY__"
            }
          ]
        },
        "options": {}
      },
      "id": "bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb",
      "name": "Fetch new signups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        760
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.email);\nconst esc = (s) => '\"' + String(s ?? '').replaceAll('\"', '\"\"') + '\"';\nconst csv = ['email,created_at,confirmed_at', ...rows.map(r =>\n  [esc(r.email), esc(r.created_at), esc(r.confirmed_at)].join(',')\n)].join('\\n');\nreturn [{ json: { count: rows.length, csv, date: $now.toISO().slice(0, 10) } }];\n"
      },
      "id": "cccccccc-cccc-4ccc-cccc-cccccccccccc",
      "name": "Build CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        760
      ]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "csv",
        "options": {
          "fileName": "={{ 'teahappy-signups-' + $json.date + '.csv' }}"
        }
      },
      "id": "dddddddd-dddd-4ddd-dddd-dddddddddddd",
      "name": "Attach CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        740,
        760
      ]
    },
    {
      "parameters": {
        "fromEmail": "Teahappy <__FROM_EMAIL__>",
        "toEmail": "__STAFF_EMAIL__",
        "subject": "={{ 'Teahappy waitlist: ' + $('Build CSV').item.json.count + ' new emails' }}",
        "html": "=<p>{{ $('Build CSV').item.json.count }} new waitlist emails in the last 24 hours.</p><p>CSV attached (email, created_at, confirmed_at). Supabase is still the database \u2014 this is only a copy for you.</p>",
        "options": {
          "appendAttribution": false,
          "attachments": "data"
        }
      },
      "id": "eeeeeeee-eeee-4eee-eeee-eeeeeeeeeeee",
      "name": "Send daily digest",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        980,
        760
      ],
      "credentials": {
        "smtp": {
          "id": "SMTP",
          "name": "SMTP (Resend)"
        }
      }
    }
  ],
